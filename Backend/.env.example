# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Process Clustering & Concurrency
# Set CLUSTER_MODE=true on dedicated multi-core servers (EC2/VPS/Bare Metal).
# Keep CLUSTER_MODE=false (default) for local dev, PM2, or container platforms (Render, Heroku, K8s).
CLUSTER_MODE=false
# Optional override for number of worker processes (defaults to os.cpus().length)
# WEB_CONCURRENCY=2
# Graceful shutdown timeout in milliseconds for in-flight requests (default: 15000)
SHUTDOWN_TIMEOUT_MS=15000

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/webthropic

# Session Secret (random 32+ character string)
SESSION_SECRET=replace_with_a_secure_long_random_secret_string

# Anthropic Claude API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google OAuth Credentials
GOOGLE_CLIENT_ID=789122506863-0qj9a7qj3fhqqcubd5jpsdhf79v1.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-OfNgr1Gi3G5UqjtReHu3cpelU
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=Ov23litdA3kwdLrI6
GITHUB_CLIENT_SECRET=c199f679a0e2993ea71116f748b6a1463c0d
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# Email Configuration (Nodemailer SMTP)
# If left empty, emails (e.g. verification & reset links) will log to the console during development
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=user@example.com
# SMTP_PASSWORD=your_smtp_password
# EMAIL_FROM=no-reply@webthropic.com
